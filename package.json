{
  "name": "2027",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write \"**/*.{ts,tsx,html,css,json,md,yml}\" \"!node_modules\" \"!dist\" \"!package-lock.json\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,html,css,json,md,yml}\" \"!node_modules\" \"!dist\" \"!package-lock.json\"",
    "test:unit": "vitest run --passWithNoTests",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "test": "npm run test:unit && npm run test:rules"
  },
  "dependencies": {
    "firebase": "^11.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.0.0",
    "firebase-tools": "^13.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  }
}
